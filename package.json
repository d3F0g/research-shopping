{
  "name": "research-shopping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "NODE_ENV=${NODE_ENV:-development} tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "EXA_RESEARCH_ENABLED=false vitest run",
    "test:watch": "EXA_RESEARCH_ENABLED=false vitest",
    "test:e2e": "NODE_ENV=test FIELDNOTE_TEST_FIXTURES=true EXA_RESEARCH_ENABLED=false playwright test",
    "verify:offline": "NODE_ENV=test FIELDNOTE_TEST_FIXTURES=true EXA_RESEARCH_ENABLED=false node .agents/skills/verify-research-shopping/scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "exa-js": "^2.28.0",
    "hono": "^4.10.4",
    "lucide-react": "^1.74.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    }
  }
}
